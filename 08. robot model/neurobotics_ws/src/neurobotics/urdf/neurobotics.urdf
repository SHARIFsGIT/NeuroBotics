  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <!-- Resolved by xacro when the launch file processes this URDF.
           Must stay a package-relative path, never an absolute machine path. -->
      <parameters>$(find neurobotics)/config/my_controllers.yaml</parameters>
    </plugin>
  </gazebo>
  <!-- ============ Gazebo materials (one entry per link) ============ -->
  <gazebo reference="base_link"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="arm1"><material>Gazebo/Silver</material></gazebo>
  <gazebo reference="arm2"><material>Gazebo/White</material></gazebo>
  <gazebo reference="arm3"><material>Gazebo/White</material></gazebo>
  <gazebo reference="arm4"><material>Gazebo/White</material></gazebo>
  <gazebo reference="arm5"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="arm_base_Link"><material>Gazebo/Green</material></gazebo>
  <gazebo reference="DCW2"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="DCW2"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="Gripping"><material>Gazebo/White</material></gazebo>
  <gazebo reference="rlink1"><material>Gazebo/White</material></gazebo>
  <gazebo reference="rlink2"><material>Gazebo/White</material></gazebo>
  <gazebo reference="rlink3"><material>Gazebo/White</material></gazebo>
  <gazebo reference="llink1"><material>Gazebo/White</material></gazebo>
  <gazebo reference="llink2"><material>Gazebo/White</material></gazebo>
  <gazebo reference="llink3"><material>Gazebo/White</material></gazebo>
  <gazebo reference="lwheel1"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="lwheel2"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="rwheel1"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="rwheel2"><material>Gazebo/Black</material></gazebo>

  <!-- ============ Friction ============ -->
  <gazebo reference="lwheel1"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo>
  <gazebo reference="lwheel2"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo>
  <gazebo reference="rwheel1"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo>
  <gazebo reference="rwheel2"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo>
  <gazebo reference="base_link"><mu1>0.5</mu1><mu2>0.5</mu2></gazebo>

  <!-- ============ Sensors ============ -->
  <!-- The ray sensor sits on laser1_frame, the FRONT-right corner mount
       (laser0_frame at the rear would sweep across the robot's own arm).
       Beams leave the body immediately toward the front; rear/left beams
       partly hit the chassis - obstacle_avoid.py filters those out. -->
  <gazebo reference="laser1_frame">
    <sensor type="ray" name="lidar_front">
      <pose>0 0 0.06 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan><horizontal>
          <samples>360</samples><resolution>1.0</resolution>
          <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
        </horizontal></scan>
        <range><min>0.2</min><max>8.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=/scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser1_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <!-- IMU on the chassis. Wheel odometry cannot see yaw that happens through
       tyre scrub (both wheels rolling equally while the body still rotates),
       so scripts that need a trustworthy heading (obstacle_avoid, the
       velocity calibration) read /imu instead - the same role the IMU+EKF
       play on the real robot. -->
  <gazebo reference="base_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros><remapping>~/out:=/imu</remapping></ros>
        <frame_name>base_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="arm4">
    <sensor type="camera" name="arm_camera">
      <!-- The robot's only camera, physically the DCW2 housing on arm4 near
           the wrist. GOTCHA: the sensor is NOT attached to the DCW2 link.
           Gazebo welds fixed-joint links into their parent, and in the
           process DROPS any <pose> inside sensors on the welded-away link
           (the lidar's 6 cm z-offset was silently eaten the same way). The
           sensor would land on DCW2's origin, INSIDE its housing mesh, and
           only ever see grey. So the sensor hangs on arm4 (a real link).
           MOUNT DIRECTION: the optical axis is PARALLEL to the arm's tool
           axis (arm4's +Z - the direction the gripper points), with the
           sensor pushed out behind the DCW2 housing so no mesh blocks the
           view. Consequence, deliberately physical: with the arm straight
           (all joints 0) the camera looks straight UP and sees only sky -
           NOT the floor. To look at the floor/line, the arm must pitch
           forward: e.g. arm2=-0.70, arm3=-0.70, arm4=-0.87 rad tips the
           view 40 deg below horizontal, seeing the floor 0.4-1.4 m ahead
           of the base (line_follow.py commands exactly this pose). -->
      <pose>-0.077 0.0025 0.058 0 -1.5708 0</pose>
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.085</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.02</near><far>300</far></clip>
      </camera>
      <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <!-- Fully-qualified names: '~'-relative remappings are not applied
               by this plugin, topics then stay under /arm_camera/... -->
          <remapping>/arm_camera/image_raw:=/camera/image_raw</remapping>
          <remapping>/arm_camera/camera_info:=/camera/camera_info</remapping>
        </ros>
        <frame_name>DCW2</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
