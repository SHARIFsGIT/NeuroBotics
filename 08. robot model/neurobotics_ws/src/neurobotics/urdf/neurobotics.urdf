  <!-- NOTE: the robot's only camera is the DCW2 housing on arm4 (near the
       wrist). The old chassis-front "Camera" link was removed to match the
       real robot; the Gazebo camera sensor now sits on DCW2 - see the sensor
       block at the bottom of this file. -->
  <!-- NOTE on wheel inertias: the SolidWorks-exported values (~4.5e-5 kg m^2)
       are physically honest but far too small for ODE's 1 ms timesteps: a
       2 N m velocity motor on 7.5e-5 kg m^2 gives ~26,000 rad/s^2 and the
       bang-bang motor overshoots every step, making wheels oscillate/run away
       (measured +52 rad/s at zero command). All four wheel inertias are
       therefore scaled x50 for simulation stability - a common practice for
       small sim robots. Masses are unchanged. -->
  <link
    name="lwheel1">
    <inertial>
      <origin
        xyz="-2.05401095824953E-06 1.7379895593389E-06 0.0108532997143464"
        rpy="0 0 0" />
      <mass
        value="0.0973137194820634" />
      <inertia
        ixx="2.22622916100385E-03"
        ixy="-1.31175451437957E-10"
        ixz="2.4691417638339E-09"
        iyy="2.22620693937435E-03"
        iyz="-4.9776391261432E-10"
        izz="3.72981721990305E-03" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://neurobotics/meshes/lwheel1.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.298039215686275 0.298039215686275 0.298039215686275 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0108" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.022"/>
      </geometry>
    </collision>
  </link>
  <joint
    name="lwheel1_Joint"
    type="continuous">
    <origin
      xyz="0.0775753787975409 0.075 0.0399999999999998"
      rpy="-1.5707963267949 0 0" />
    <parent
      link="base_link" />
    <child
      link="lwheel1" />
    <!-- Axis sign: with rpy = -90 deg about X, "0 0 1" resolves to +Y in the
         base frame, so a POSITIVE wheel velocity drives the robot FORWARD. -->
    <axis
      xyz="0 0 1" />
    <!-- Effort kept low (1 Nm) relative to the tiny wheel inertia: a 5 Nm
         velocity motor on a 7.5e-5 kg m^2 wheel makes ODE's bang-bang motor
         overshoot every step and the wheel runs away (~50 rad/s). Joint
         damping/friction removed for the same reason - the velocity motor
         already damps, and ODE's damping term pumps energy at 1 ms steps. -->
    <limit effort="2.0" velocity="20"/>
  </joint>
