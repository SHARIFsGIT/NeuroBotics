<robot
  name="M3Pro">
  
  <!-- Root link at ground level. Intentionally has no visual/collision/inertia:
       it is merged into base_link by fixed-joint reduction. -->
  <link name="base_footprint"/>
    
  <joint name="link2footprint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  
  <link
    name="base_link">
    <inertial>
      <!-- Mass was set to 4.0 kg; inertia recomputed as a uniform box over the
           mesh bounding box (0.2764 x 0.2216 x 0.1725 m). The SolidWorks export
           carried inertia values from a much lighter part, which made the
           chassis unrealistically twitchy in the simulator. -->
      <origin
        xyz="-0.0230945655800945 -0.000624366433481225 0.0924263074305092"
        rpy="0 0 0" />
      <mass
        value="4.0" />
      <inertia
        ixx="0.02629"
        ixy="0.0"
        ixz="0.0"
        iyy="0.03539"
        iyz="0.0"
        izz="0.04184" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://neurobotics/meshes/base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.501960784313725 0.501960784313725 0.501960784313725 1" />
      </material>
    </visual>
