<?xml version="1.0"?>
<package format="3">
  <name>eira_simulation</name>
  <version>0.1.0</version>
  <description>Reproducible M3 Pro Gazebo experiments with existing E-AIRA contracts.</description>
  <maintainer email="shariful@example.com">E-AIRA maintainers</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>ament_index_python</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>gazebo_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>arm_msgs</depend>
  <depend>arm_interface</depend>
  <exec_depend>eira_bringup</exec_depend>
  <exec_depend>eira_brain</exec_depend>
  <exec_depend>eira_evaluation</exec_depend>
  <exec_depend>eira_perception</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>dwb_core</exec_depend>
  <exec_depend>dwb_plugins</exec_depend>
  <exec_depend>dwb_critics</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
