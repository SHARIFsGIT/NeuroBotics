<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eira_brain</name>
  <version>0.1.0</version>
  <description>
    E-AIRA cognitive layer: LLM-based task planner (Ollama/Phi-3) that converts
    natural-language commands into validated JSON action sequences and executes
    them as a Nav2 action client. Part of the E-AIRA edge robot assistant.
  </description>
  <maintainer email="shariful@example.com">Shariful</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>

  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
