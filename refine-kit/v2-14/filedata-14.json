{"README.md":["sh start_agent.sh","","ros2 launch slam_mapping gmapping.launch.py","","ros2 launch slam_mapping slam_view.launch.py","","ros2 run yahboomcar_ctrl yahboom_keyboard","","ros2 launch M3Pro_demo camera_arm_kin.launch.py","","ros2 run M3Pro_demo follow_line","","ros2 topic pub /arm6_joints arm_msgs/msg/ArmJoints {\"joint1: 90, joint2: 140, joint3: 20, joint4: 10, joint5: 90, joint6: 180, time: 1500\"} --once","","ros2 launch slam_mapping save_map.launch.py"],"gmapping.launch.py":["# --- IMPORTING ROS 2 LAUNCH TOOLS ---","from launch_ros.actions import Node","from launch.substitutions import LaunchConfiguration","from launch.actions import DeclareLaunchArgument","import os","from ament_index_python.packages import get_package_share_directory","from launch import LaunchDescription","from launch.launch_description_sources import PythonLaunchDescriptionSource","from launch_ros.actions import Node","from launch.actions import IncludeLaunchDescription","# (Note: Some imports are duplicated here, which is harmless, just a bit messy)","","","def generate_launch_description():","    # These lists are created but not actually used in this file. ","    # They are just left over from a template the programmer used.","    declared_arguments = []","    declared_env_vars = []","    declared_parameters = []","    ","    # --- FINDING ALL THE PIECES ---","    ","    # 1. Laser Merger path","    laser_merge_launch_file = os.path.join(","        get_package_share_directory('ira_laser_tools'),","        'launch',","        'merge_multi.launch.py'","    )","","    # 2. Laser Filter path","    laser_filter_launch_file = os.path.join(","        get_package_share_directory('yahboom_laser_filter'),","        'launch',","        'laser_filter_node.launch.py'","    )","    ","    # 3. EKF (Extended Kalman Filter) path","    ekf_odom_launch_file = os.path.join(","        get_package_share_directory('ekf_bringup'),","        'launch',","        'ekf.launch.py'","    )","    ","    # 4. Gmapping (The actual SLAM AI!) path","    gmapping_launch_file = os.path.join(","        get_package_share_directory('slam_gmapping'),","        'launch',","        'slam_gmapping.launch.py'","    )","    ","    # 5. IMU Filter Node","    # Instead of a launch file, we start this one directly.","    imu_filter_madgwick_node = Node(","        package='imu_filter_madgwick',","        executable='imu_filter_madgwick_node',","        # Remapping is a superpower in ROS 2! ","        # The IMU node publishes its data on a topic called '/imu'.","        # But the robot's brain expects the data on a topic called '/imu/data_raw'.","        # This line acts like a mail forwarder, redirecting the letters automatically.","        remappings=[('/imu','/imu/data_raw')],","        name='imu_filter_madgwick_node',","    )","","    # --- THE FINAL LIST ---","    # Hand the list of all 5 programs back to ROS 2 to start them all at once.","    return LaunchDescription([","    ","        # 1. Start the Laser Merger (Stitch the 360 radar together)","        IncludeLaunchDescription(","            PythonLaunchDescriptionSource(laser_merge_launch_file)","        ),","","        # 2. Start the Laser Filter (Remove the robot's own body from the radar)","        IncludeLaunchDescription(","            PythonLaunchDescriptionSource(laser_filter_launch_file)","        ),","        ","        # 3. Start the IMU Filter (Clean up the gyroscope/accelerometer data)","        imu_filter_madgwick_node,","        ","        # 4. Start the EKF (Calculate exactly how far the robot has driven)","        IncludeLaunchDescription(","            PythonLaunchDescriptionSource(ekf_odom_launch_file)","        ),","        ","        # 5. Start Gmapping SLAM!","        # This AI listens to the cleaned radar data AND the EKF distance data.","        # It compares them frame-by-frame to guess if the robot is in a hallway or a room,","        # and slowly draws a 2D map of the environment.","        IncludeLaunchDescription(","            PythonLaunchDescriptionSource(gmapping_launch_file)","        )","","    ])"],"slam_view.launch.py":["# --- IMPORTING ROS 2 LAUNCH TOOLS ---","# (Note: The programmer imported a lot of tools here that they didn't actually end up using, ","# like IfCondition, ExecuteProcess, etc. That's normal when copying from templates!)","from launch_ros.actions import Node","from launch.actions import IncludeLaunchDescription","from ament_index_python.packages import get_package_share_directory","from launch import LaunchDescription","from launch.actions import DeclareLaunchArgument, IncludeLaunchDescription, ExecuteProcess","from launch.conditions import IfCondition, UnlessCondition","from launch.substitutions import LaunchConfiguration","from launch_ros.actions import Node, SetRemap","from launch_ros.substitutions import FindPackageShare","from launch.launch_description_sources import PythonLaunchDescriptionSource","from launch.actions import Shutdown","import os","","def generate_launch_description():","    ","    # --- SETTING UP VARIABLES ---","    ","    # 1. use_sim_time: ","    # In robotics, you can use real-world time (the clock on the wall) or \"simulation time\" ","    # (a fake clock used when running in a video game/simulator). We are on a real robot, so 'false'.","    use_sim_time = LaunchConfiguration('use_sim_time', default='false')","    ","    # 2. rviz_config:","    # Find the path to a special settings file called 'slam_rviz.rviz' inside the 'slam_mapping' folder.","    # RViz has millions of buttons and settings. This file pre-configures all of them so the screen ","    # opens up perfectly set up to view SLAM mapping!","    rviz_config = LaunchConfiguration('rviz_config', default=os.path.join(","        get_package_share_directory('slam_mapping'),","        'rviz',","        'slam_rviz.rviz'","    ))","    ","    # Declare that 'rviz_config' is a variable that ROS 2 should know about.","    rviz_config_arg = DeclareLaunchArgument('rviz_config', default_value=rviz_config)","","    # --- THE RVIZ NODE ---","    # Start the RViz program!","    rviz_node = Node(","        package='rviz2',               # Look in the rviz2 package","        executable='rviz2',            # Find the RViz executable","        name='rviz2',                  # Name it 'rviz2' in the ROS 2 network","        output='screen',              # Print any errors directly to our terminal","        ","        # Give RViz some startup arguments (command line flags)","        arguments=[","            '-d', rviz_config,         # '-d' means \"Load this configuration file automatically\"","            use_sim_time               # Tell it to use real-world time","        ]","    )","    ","    # --- THE FINAL LIST ---","    # Hand the list back to ROS 2 to start the program.","    return LaunchDescription([","        rviz_config_arg,  # Load the variable","        rviz_node,        # Start RViz!","    ])"],"yahboom_keyboard.py":["#!/usr/bin/env python","# encoding: utf-8","","# --- IMPORTING TOOLS ---","import sys","import select","import termios","import tty","import time","","import rclpy","from rclpy.node import Node","from geometry_msgs.msg import Twist","from arm_msgs.msg import ArmJoint, ArmJoints","","# --- PROFESSIONAL CONTROL PANEL MENU ---","msg = \"\"\"","===================================="," TELEOPERATION (Mecanum & 6-DOF Arm)","====================================",""," [ BASE MOTION ]","   i / ,       : Forward / Backward","   j / l       : Rotate Left / Right (in-place)","   a / d       : Strafe Left / Right (Mecanum)","   u / o / m /.: Diagonal Movements",""," [ ARM MOTION (5 deg / press) ]","   1 / 2       : Joint 1 (Base)      Down / Up","   3 / 4       : Joint 2 (Shoulder)  Down / Up","   5 / 6       : Joint 3 (Elbow)      Down / Up","   7 / 8       : Joint 4 (Wrist)     Down / Up","   9 / 0       : Joint 5 (Wrist Rot) Down / Up","   g / h       : Joint 6 (Gripper)   Close / Open",""," [ SYSTEM ]","   SPACE       : EMERGENCY STOP (Base + Arm)","   s           : PAUSE ALL CONTROLS (Press 's' again to resume)","   r           : Reset Arm to Home Position","   q / z       : Increase / Decrease overall speed by 10%","   w / x       : Increase / Decrease linear speed by 10%","   e / c       : Increase / Decrease angular speed by 10%","   CTRL + C    : Quit","============================================================","\"\"\"","","# Maps keys to (forward_back, strafe_left_right, rotate_left_right)","moveBindings = {","    'i': (1, 0, 0),     'I': (1, 0, 0),","    ',': (-1, 0, 0),    'M': (-1, 0, 0),","    'a': (0, 1, 0),     'A': (0, 1, 0),","    'd': (0, -1, 0),    'D': (0, -1, 0),","    'j': (0, 0, 1),     'J': (0, 0, 1),","    'l': (0, 0, -1),    'L': (0, 0, -1),","    'u': (1, 1, 0),     'U': (1, 1, 0),","    'o': (1, -1, 0),    'O': (1, -1, 0),","    'm': (-1, 1, 0),     '.': (-1, -1, 0),","}","","speedBindings = {","    'Q': (1.1, 1.1), 'Z': (.9, .9), 'W': (1.1, 1), 'X': (.9, 1),","    'E': (1, 1.1), 'C': (1, .9), 'q': (1.1, 1.1), 'z': (.9, .9),","    'w': (1.1, 1), 'x': (.9, 1), 'e': (1, 1.1), 'c': (1, .9),","}","","class YahboomKeyboard(Node):","    def __init__(self, name):","        super().__init__(name)","        ","        # Publishers","        self.pub_cmd_vel = self.create_publisher(Twist, 'cmd_vel', 1)","        self.pub_arm_single = self.create_publisher(ArmJoint, \"arm_joint\", 100)","        self.pub_arm_all = self.create_publisher(ArmJoints, \"arm6_joints\", 100)","        ","        # Parameters (Safety Speed Limits)","        self.declare_parameter(\"linear_speed_limit\", 1.0)","        self.declare_parameter(\"angular_speed_limit\", 5.0)","        self.linear_speed_limit = self.get_parameter(\"linear_speed_limit\").get_parameter_value().double_value","        self.angular_speed_limit = self.get_parameter(\"angular_speed_limit\").get_parameter_value().double_value","        ","        # State Trackers","        self.arm_joints = [90, 90, 0, 0, 90, 90]","        self.settings = termios.tcgetattr(sys.stdin)","        ","        # Initialize arm to home position safely","        self.reset_arm()","","    def getKey(self):","        tty.setraw(sys.stdin.fileno())","        rlist, _, _ = select.select([sys.stdin], [], [], 0.1)","        if rlist:","            key = sys.stdin.read(1)","        else:","            key = ''","        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, self.settings)","        return key","        ","    def vels(self, speed, turn):","        return f\"Current Speed -> Linear: {speed:.2f} m/s | Angular: {turn:.2f} rad/s\"","    ","    def step_arm_joint(self, joint_id, delta):","        self.arm_joints[joint_id - 1] += delta","        ","        # Safety limits to prevent breaking the arm","        if joint_id == 5:","            self.arm_joints[joint_id - 1] = max(0, min(270, self.arm_joints[joint_id - 1]))","        elif joint_id == 6:","            self.arm_joints[joint_id - 1] = max(30, min(180, self.arm_joints[joint_id - 1]))","        else:","            self.arm_joints[joint_id - 1] = max(0, min(180, self.arm_joints[joint_id - 1]))","            ","        arm_msg = ArmJoint()","        arm_msg.id = joint_id","        arm_msg.joint = int(self.arm_joints[joint_id - 1])","        arm_msg.time = 500","        self.pub_arm_single.publish(arm_msg)","        ","        action = \"Opening\" if delta > 0 else \"Closing\"","        if joint_id != 6:","            action = \"Up\" if delta > 0 else \"Down\"","        print(f\"[ARM] Joint {joint_id} -> {action} -> {arm_msg.joint} deg\")","","    def reset_arm(self):","        self.arm_joints = [90, 90, 0, 0, 90, 90]","        arm_msg = ArmJoints()","        arm_msg.joint1 = self.arm_joints[0]","        arm_msg.joint2 = self.arm_joints[1]","        arm_msg.joint3 = self.arm_joints[2]","        arm_msg.joint4 = self.arm_joints[3]","        arm_msg.joint5 = self.arm_joints[4]","        arm_msg.joint6 = self.arm_joints[5]","        arm_msg.time = 2000","        self.pub_arm_all.publish(arm_msg)","        print(\"[SYSTEM] Arm reset to Home Position.\")","","    def emergency_stop(self):","        # 1. Stop Wheels","        self.pub_cmd_vel.publish(Twist())","        # 2. Stop Arm (Send current positions with 100ms time to force immediate braking)","        arm_msg = ArmJoints()","        arm_msg.joint1 = self.arm_joints[0]","        arm_msg.joint2 = self.arm_joints[1]","        arm_msg.joint3 = self.arm_joints[2]","        arm_msg.joint4 = self.arm_joints[3]","        arm_msg.joint5 = self.arm_joints[4]","        arm_msg.joint6 = self.arm_joints[5]","        arm_msg.time = 100","        self.pub_arm_all.publish(arm_msg)","","def main():","    rclpy.init()","    robot_teleop = YahboomKeyboard(\"yahboom_keyboard_ctrl\")","    ","    speed, turn = 0.2, 1.0","    x, y, th = 0, 0, 0","    stop = False","    count = 0","    twist = Twist()","    ","    try:","        print(msg)","        print(robot_teleop.vels(speed, turn))","        ","        while True:","            key = robot_teleop.getKey()","            ","            # Handle Pause/Resume","            if key in (\"s\", \"S\"):","                stop = not stop","                print(f\"[SYSTEM] ALL CONTROLS PAUSED: {stop}\")","                if stop:","                    robot_teleop.emergency_stop() # Lock everything immediately","                    x, y, th = 0, 0, 0","","            # Handle Emergency Stop","            elif key == ' ':","                robot_teleop.emergency_stop()","                x, y, th = 0, 0, 0","                print(\"[SYSTEM] EMERGENCY STOP ENGAGED.\")","                ","            # If NOT paused, process movement","            elif not stop:","                if key in moveBindings.keys():","                    x, y, th = moveBindings[key]","                    count = 0\t","                elif key in speedBindings.keys():","                    speed = speed * speedBindings[key][0]","                    turn = turn * speedBindings[key][1]","                    count = 0","                    speed = min(speed, robot_teleop.linear_speed_limit)","                    turn = min(turn, robot_teleop.angular_speed_limit)","                    print(robot_teleop.vels(speed, turn))","                    ","                # Arm Controls","                elif key == '1': robot_teleop.step_arm_joint(1, -5)","                elif key == '2': robot_teleop.step_arm_joint(1, 5)","                elif key == '3': robot_teleop.step_arm_joint(2, -5)","                elif key == '4': robot_teleop.step_arm_joint(2, 5)","                elif key == '5': robot_teleop.step_arm_joint(3, -5)","                elif key == '6': robot_teleop.step_arm_joint(3, 5)","                elif key == '7': robot_teleop.step_arm_joint(4, -5)","                elif key == '8': robot_teleop.step_arm_joint(4, 5)","                elif key == '9': robot_teleop.step_arm_joint(5, -5)","                elif key == '0': robot_teleop.step_arm_joint(5, 5)","                ","                # NEW Gripper Controls (g to close, h to open)","                elif key in ('g', 'G'): robot_teleop.step_arm_joint(6, -5)","                elif key in ('h', 'H'): robot_teleop.step_arm_joint(6, 5)","                ","                elif key in ('r', 'R'): robot_teleop.reset_arm()","                else:","                    count = count + 1","                    if count > 4:","                        x, y, th = 0, 0, 0","                    if key == '\\x03':  # Ctrl+C","                        break","            ","            # If paused, ignore everything except Ctrl+C","            else:","                if key == '\\x03':","                    break","                elif key != '':","                    print(\"[SYSTEM] System paused. Press 's' to resume.\")","                ","            # Calculate and publish base movement","            twist.linear.x = speed * x","            twist.linear.y = speed * y","            twist.angular.z = turn * th","            ","            if not stop:","                robot_teleop.pub_cmd_vel.publish(twist)","            else:","                robot_teleop.pub_cmd_vel.publish(Twist())","            ","    except Exception as e:","        print(f\"[ERROR] {e}\")","    finally:","        # Graceful shutdown: stop everything before exiting","        robot_teleop.emergency_stop()","        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, robot_teleop.settings)","        robot_teleop.destroy_node()","        rclpy.shutdown()"],"camera_arm_kin.launch.py":["# --- IMPORTING ROS 2 LAUNCH TOOLS ---","from launch import LaunchDescription  # The main container that holds our list of programs to start","from launch_ros.actions import Node  # A tool to start a single ROS 2 program (Node)","import os  # Lets Python interact with computer folders and file paths","from launch.actions import IncludeLaunchDescription  # A tool to run ANOTHER launch file inside this one","from launch.launch_description_sources import PythonLaunchDescriptionSource  # Tells ROS the other launch file is written in Python","from ament_index_python.packages import get_package_share_directory  # A ROS 2 tool that finds where a package is installed on the robot","","","# Every ROS 2 Python launch file MUST have this exact function.","# When you type \"ros2 launch ...\" in the terminal, ROS 2 secretly calls this function to figure out what to do.","def generate_launch_description():","","    # --- PROGRAM 1: THE CAMERA ---","    # We want to turn on the robot's camera. ","    # Instead of writing all the camera setup code here, we use a shortcut and load an existing launch file.","    camera_driver_launch = IncludeLaunchDescription(","        PythonLaunchDescriptionSource([os.path.join(","        # Find the folder where the 'orbbec_camera' package lives on the robot.","        get_package_share_directory('orbbec_camera'), 'launch'),","         # Inside that folder, look for a file called 'dabai_dcw2.launch.py' and run it.","         '/dabai_dcw2.launch.py'])","    )","    # \"dabai\" is likely the model name of your camera. This starts the camera driver so the robot can \"see\".","","","    # --- PROGRAM 2: THE MATH BRAIN ---","    # Here we define a single ROS 2 Node (a mini-program) to start.","    kin_node = Node(","     package='arm_kin',       # Look in the 'arm_kin' package (Kinematics = the math of robot arm movement).","     executable='kin_srv',   # Find the program inside it called 'kin_srv' (srv = service).","     name='kin_ik_fk',       # Give this running program the nickname 'kin_ik_fk' so other programs can talk to it.","                             # \"ik\" stands for Inverse Kinematics, \"fk\" stands for Forward Kinematics!","    )","","    ","    # --- THE FINAL LIST ---","    # Hand the \"Director's Clapperboard\" back to ROS 2.","    # It contains a list of everything we just defined: [Turn on the camera, Turn on the math brain]","    return LaunchDescription([camera_driver_launch, kin_node])"],"follow_line.py":["#ros lib","import rclpy","from rclpy.node import Node","from std_msgs.msg import Bool,Int16,UInt16,String","from geometry_msgs.msg import Twist","from sensor_msgs.msg import CompressedImage, LaserScan, Image","#common lib","import os","import threading","import math","from M3Pro_demo.follow_common import *","RAD2DEG = 180 / math.pi","print (\"import finish\")","cv_edition = cv.__version__","print(\"cv_edition: \",cv_edition)","","import cv2","from arm_msgs.msg import ArmJoints","from message_filters import Subscriber, TimeSynchronizer,ApproximateTimeSynchronizer","from cv_bridge import CvBridge","encoding = ['16UC1', '32FC1']","from dt_apriltags import Detector","from M3Pro_demo.vutils import draw_tags","import numpy as np","from arm_interface.msg import AprilTagInfo,CurJoints","from M3Pro_demo.compute_joint5 import *","","class LineDetect(Node):","\tdef __init__(self,name):","\t\tsuper().__init__(name)","","","\t\t#create a publisher","\t\tself.pub_cmdVel = self.create_publisher(Twist,\"/cmd_vel\",1)","\t\tself.pub_rgb = self.create_publisher(Image,\"/linefollow/rgb\",1)","\t\tself.pub_Buzzer = self.create_publisher(UInt16,'/beep',1)","\t\t#create a subscriber","\t\tself.sub_JoyState = self.create_subscription(Bool,\"/JoyState\",self.JoyStateCallback,1)","\t\tself.sub_laser = self.create_subscription(LaserScan,\"/scan1\",self.registerScan,1)","\t\tself.sub_JoyState = self.create_subscription(Bool,'/JoyState', self.JoyStateCallback,1)","","\t\tself.rgb_image_sub = Subscriber(self, Image, '/camera/color/image_raw')","\t\tself.depth_image_sub = Subscriber(self, Image, '/camera/depth/image_raw')","\t\tself.pub_SixTargetAngle = self.create_publisher(ArmJoints, \"arm6_joints\", 10)\t\t","\t\tself.pos_info_pub = self.create_publisher(AprilTagInfo,\"PosInfo\",1)","\t\tself.TargetJoint5_pub = self.create_publisher(Int16, \"set_joint5\", 10)","\t\tself.TargetJoint6_pub = self.create_publisher(Int16, \"set_joint6\", 10)","\t\tself.pub_cur_joints = self.create_publisher(CurJoints,\"Curjoints\",1)","\t\tself.sub_grasp_status = self.create_subscription(Bool,\"grasp_done\",self.get_graspStatusCallBack,100)","\t\tself.largemodel_arm_done_pub = self.create_publisher(String,'/action_feedback',1)\t","\t\tself.init_joints = [90, 90, 12, 20, 90, 0]","\t\twhile not self.pub_SixTargetAngle.get_subscription_count():","\t\t\tself.pubSixArm(self.init_joints)","\t\t\ttime.sleep(0.1)","\t\tself.pubSixArm(self.init_joints)","\t\tself.ts = ApproximateTimeSynchronizer([self.rgb_image_sub, self.depth_image_sub], 1, 0.5)","\t\tself.ts.registerCallback(self.callback)","","\t\tself.rgb_bridge = CvBridge()","\t\tself.depth_bridge = CvBridge()","","\t\tself.at_detector = Detector(searchpath=['apriltags'], ","                                    families='tag36h11',","                                    nthreads=8,","                                    quad_decimate=2.0,","                                    quad_sigma=0.0,","                                    refine_edges=1,","                                    decode_sharpening=0.25,","                                    debug=0)","\t\tself.move_flag = True ","\t\tself.pubPos_flag = True","","\t\tself.declare_param()","\t\tself.Joy_active = False","\t\tself.img = None","\t\tself.circle = ()","\t\tself.hsv_range = ()","\t\tself.Roi_init = ()","\t\tself.warning = 1","\t\tself.Start_state = True","\t\tself.dyn_update = False","\t\tself.Buzzer_state = False","\t\tself.select_flags = False","\t\tself.Track_state = 'identify'","\t\tself.windows_name = 'frame'","\t\tself.cols, self.rows = 0, 0","\t\tself.Mouse_XY = (0, 0)","\t\tself.hsv_text = \"/home/jetson/yahboomcar_ws/src/M3Pro_demo/M3Pro_demo/LineFollowHSV.text\"","\t\tself.color = color_follow()","\t\tself.scale = 1000","\t\tself.FollowLinePID = (50, 0, 10)","\t\tself.RemovePID = (40, 0, 15.0)","\t\tself.linear = 0.2","\t\t#self.LaserAngle = 60","\t\tself.PID_init()\t","\t\tself.img_flip = False","\t\tself.refresh  = False\t","","\t\tself.pubCurrentJoints()","\t\tself.tags = []","\t\tself.depth_image_info = []","\t\tself.joint5 = Int16()","\t\tself.joint6 = Int16()","\t\tself.joint6.data = 120","\t\tself.Start_ = True","\t\tself.start_time = time.time()","\t\tself.count = True","\t\t#self.ResponseDist = 0.25","\t\tself.front_warning = 0","\t\tself.Joy_active = False","\t\tprint(\"Init Done.\")","\t\tprint(\"----------------------------\")","\t\tprint(\"self.LaserAngle: \",self.LaserAngle)","\t\tprint(\"self.ResponseDist: \",self.ResponseDist)","","","","\tdef JoyStateCallback(self, msg):","\t\tif not isinstance(msg, Bool): return","\t\tself.Joy_active = msg.data","","\tdef registerScan(self, scan_data):","\t\tself.front_warning = 0","\t\tif not isinstance(scan_data, LaserScan): return","\t\tranges = np.array(scan_data.ranges)","\t\tfor i in range(len(ranges)):","\t\t\tangle = (scan_data.angle_min + scan_data.angle_increment * i) * RAD2DEG","\t\t\tif (abs(angle) < self.LaserAngle*0.5 or abs(angle) > 360 - self.LaserAngle*0.5) and ranges[i] !=0.0 :","\t\t\t\tif ranges[i] <= self.ResponseDist * 1.5: ","\t\t\t\t\t#print(\"-+-+-+-+-+-+-+-+-\")","\t\t\t\t\tself.front_warning += 1\t\t\t","","\t","\tdef pubCurrentJoints(self):","\t\tcur_joints = CurJoints()","\t\tcur_joints.joints = self.init_joints","\t\tself.pub_cur_joints.publish(cur_joints)","","    ","\tdef get_graspStatusCallBack(self,msg):","\t\tif msg.data == True:","\t\t\tself.move_flag = True","\t\t\tself.pubPos_flag  = True","\t\t\tif len(self.tags) == 0:","\t\t\t\tself.Track_state = 'tracking'","","\tdef callback(self,color_frame,depth_frame):","        # 将画面转为 opencv 格式","\t\trgb_image = self.rgb_bridge.imgmsg_to_cv2(color_frame,'rgb8')","\t\trgb_image = np.copy(rgb_image)","","\t\tdepth_image = self.depth_bridge.imgmsg_to_cv2(depth_frame, encoding[1])","\t\t#depth_to_color_image = cv2.applyColorMap(cv2.convertScaleAbs(depth_image, alpha=1.0), cv2.COLORMAP_JET)","\t\tdepth_img = cv2.resize(depth_image, (640, 480))","\t\tself.depth_image_info = depth_img.astype(np.float32)","        ","\t\tself.tags = self.at_detector.detect(cv2.cvtColor(rgb_image, cv2.COLOR_RGB2GRAY), False, None, 0.025)","\t\tself.tags = sorted(self.tags, key=lambda tag: tag.tag_id) ","\t\tdraw_tags(rgb_image, self.tags, corners_color=(0, 0, 255), center_color=(0, 255, 0))","        ","\t\t#depth_image","\t\tdepth_image = self.depth_bridge.imgmsg_to_cv2(depth_frame, encoding[1])","\t\t#depth_to_color_image = cv2.applyColorMap(cv2.convertScaleAbs(depth_image, alpha=1.0), cv2.COLORMAP_JET)","\t\tframe = cv2.resize(depth_image, (640, 480))","\t\tdepth_image_info = frame.astype(np.float32)","\t\taction = cv2.waitKey(1)","\t\tif self.count==True and self.Start_==True:","\t\t\tif (time.time() - self.start_time)>3:","\t\t\t\tself.Track_state = 'tracking'","\t\t\t\tself.count = False","\t\tresult_img,bin_img = self.process(rgb_image,action)","\t\tresult_img = cv2.cvtColor(result_img, cv2.COLOR_RGB2BGR)","\t\tif len(bin_img) != 0: cv.imshow('frame', ManyImgs(1, ([result_img, bin_img])))","\t\telse:cv.imshow('frame', result_img)","","\tdef pubSixArm(self, joints, id=6, angle=180.0, runtime=2000):","\t\tarm_joints =ArmJoints()","\t\tarm_joints.joint1 = 180 - joints[0]","\t\tarm_joints.joint2 = joints[1]","\t\tarm_joints.joint3 = joints[2]","\t\tarm_joints.joint4 = joints[3]","\t\tarm_joints.joint5 = joints[4]","\t\tarm_joints.joint6 = joints[5]","\t\tarm_joints.time = runtime","\t\tself.pub_SixTargetAngle.publish(arm_joints)","","\tdef declare_param(self):","\t\t#HSV","\t\tself.declare_parameter(\"Hmin\",0)","\t\tself.Hmin = self.get_parameter('Hmin').get_parameter_value().integer_value","\t\tself.declare_parameter(\"Smin\",85)","\t\tself.Smin = self.get_parameter('Smin').get_parameter_value().integer_value","\t\tself.declare_parameter(\"Vmin\",126)","\t\tself.Vmin = self.get_parameter('Vmin').get_parameter_value().integer_value","\t\tself.declare_parameter(\"Hmax\",9)","\t\tself.Hmax = self.get_parameter('Hmax').get_parameter_value().integer_value","\t\tself.declare_parameter(\"Smax\",253)","\t\tself.Smax = self.get_parameter('Smax').get_parameter_value().integer_value","\t\tself.declare_parameter(\"Vmax\",253)","\t\tself.Vmax = self.get_parameter('Vmax').get_parameter_value().integer_value","        #PID","\t\tself.declare_parameter(\"Kp\",60)","\t\tself.Kp = self.get_parameter('Kp').get_parameter_value().integer_value","\t\tself.declare_parameter(\"Ki\",0)","\t\tself.Ki = self.get_parameter('Ki').get_parameter_value().integer_value","\t\tself.declare_parameter(\"Kd\",20)","\t\tself.Kd = self.get_parameter('Kd').get_parameter_value().integer_value","\t\t#other","\t\tself.declare_parameter(\"scale\",1000)","\t\tself.scale = self.get_parameter('scale').get_parameter_value().integer_value","\t\tself.declare_parameter(\"LaserAngle\",60)","\t\tself.LaserAngle = self.get_parameter('LaserAngle').get_parameter_value().integer_value","\t\tself.declare_parameter(\"linear\",0.18)","\t\tself.linear = self.get_parameter('linear').get_parameter_value().double_value","\t\tself.declare_parameter(\"ResponseDist\",0.25)","\t\tself.ResponseDist = self.get_parameter('ResponseDist').get_parameter_value().double_value","\t\tself.declare_parameter('refresh',False)","\t\tself.refresh = self.get_parameter('refresh').get_parameter_value().bool_value","","\tdef PID_init(self):","\t\tself.PID_controller = simplePID(","            [0, 0],","            [self.FollowLinePID[0] / 1.0 / (self.scale), 0],","            [self.FollowLinePID[1] / 1.0 / (self.scale), 0],","            [self.FollowLinePID[2] / 1.0 / (self.scale), 0])  ","\t\tself.Remove_PID_controller = simplePID(","            [0, 0],","            [self.RemovePID[0] / 1.0 / (self.scale), self.RemovePID[0] / 1.0 / (self.scale)],","            [self.RemovePID[1] / 1.0 / (self.scale), self.RemovePID[1] / 1.0 / (self.scale)],","            [self.RemovePID[2] / 1.0 / (self.scale), self.RemovePID[2] / 1.0 / (self.scale)]) ","\t\t","\tdef onMouse(self, event, x, y, flags, param):","\t\tif event == 1:","\t\t\tself.Track_state = 'init'","\t\t\tself.select_flags = True","\t\t\tself.Mouse_XY = (x,y)","\t\tif event == 4:","\t\t\tself.select_flags = False","\t\t\tself.Track_state = 'mouse'","\t\tif self.select_flags == True:","\t\t\tself.cols = min(self.Mouse_XY[0], x), min(self.Mouse_XY[1], y)","\t\t\tself.rows = max(self.Mouse_XY[0], x), max(self.Mouse_XY[1], y)","\t\t\tself.Roi_init = (self.cols[0], self.cols[1], self.rows[0], self.rows[1])","","\tdef execute(self, point_x, color_radius):","","\t\tif self.Joy_active == True:","\t\t\tif self.Start_state == True:","\t\t\t\tself.PID_init()","\t\t\t\tself.Start_state = False","\t\t\treturn","\t\tself.Start_state = True","\t\tif color_radius == 0: ","\t\t\tprint(\"Not Found\")","\t\t\tself.largemodel_arm_done_pub.publish( String(data='follow_line_clear_future_done'))","","\t\t\tself.pub_cmdVel.publish(Twist())","\t\telse:","\t\t\ttwist = Twist()","\t\t\tb = UInt16()","\t\t\t[z_Pid, _] = self.PID_controller.update([(point_x - 320)*1.0/16, 0])","\t\t\t#[z_Pid, _] = self.PID_controller.update([(point_x - 10)*1.0/16, 0])","\t\t\tif self.img_flip == True: twist.angular.z = -z_Pid #-z_Pid","\t\t\t#else: twist.angular.z = (twist.angular.z+z_Pid)*0.2","\t\t\telse: twist.angular.z = +z_Pid","\t\t\t#point_x = point_x","\t\t\t#twist.angular.z=-(point_x-320)*1.0/128.0","","\t\t\ttwist.linear.x = 0.1","\t\t\tif self.front_warning > 10:","\t\t\t\tprint(\"Obstacles ahead !!!\")","\t\t\t\tself.pub_cmdVel.publish(Twist())","\t\t\t\tself.Buzzer_state = True","\t\t\t\tb.data = 1","\t\t\t\tself.pub_Buzzer.publish(b)","\t\t\telse:","\t\t\t\tif self.Buzzer_state == True:","\t\t\t\t\tb.data = 0","\t\t\t\t\tfor i in range(3): self.pub_Buzzer.publish(b)","\t\t\t\t\tself.Buzzer_state = False","                ","\t\t\t\tif abs(point_x-320)<40:","                #if abs(point_x-30)>40:","\t\t\t\t\ttwist.angular.z=0.0","\t\t\t\tif self.Joy_active == False:","\t\t\t\t\tself.pub_cmdVel.publish(twist)","\t\t\t\telse:","\t\t\t\t\ttwist.angular.z=0.0","                ","","\tdef process(self, rgb_img, action):","\t\t#print(\"********************************\")","\t\tbinary = []","\t\trgb_img = cv.resize(rgb_img, (640, 480))","\t\t# self.Track_state = 'tracking'","\t\tif self.img_flip == True: rgb_img = cv.flip(rgb_img, 1)","\t\tif action == 32: self.Track_state = 'tracking'","","\t\telif action == ord('i') or action == 105: self.Track_state = \"identify\"","\t\telif action == ord('r') or action == 114: self.Reset()","\t\telif action == ord('q') or action == 113: self.cancel()","\t\tif self.Track_state == 'init':","\t\t\tcv.namedWindow(self.windows_name, cv.WINDOW_AUTOSIZE)","\t\t\tcv.setMouseCallback(self.windows_name, self.onMouse, 0)","\t\t\tif self.select_flags == True:","\t\t\t\tcv.line(rgb_img, self.cols, self.rows, (255, 0, 0), 2)","\t\t\t\tcv.rectangle(rgb_img, self.cols, self.rows, (0, 255, 0), 2)","\t\t\t\tif self.Roi_init[0]!=self.Roi_init[2] and self.Roi_init[1]!=self.Roi_init[3]:","\t\t\t\t\trgb_img, self.hsv_range = self.color.Roi_hsv(rgb_img, self.Roi_init)","\t\t\t\t\tself.dyn_update = True","\t\t\t\t      ","\t\t\t\t    ","\t\t\telse: ","\t\t\t\t\tself.Track_state = 'init'","\t\telif self.Track_state == \"identify\":","\t\t\t#print(self.circle[0])","\t\t\tif os.path.exists(self.hsv_text): self.hsv_range = read_HSV(self.hsv_text)","\t\t\telse: self.Track_state = 'init'","\t\tif self.Track_state != 'init' and len(self.hsv_range) != 0:","\t\t\trgb_img, binary, self.circle = self.color.line_follow(rgb_img, self.hsv_range)","\t\t\tif self.dyn_update == True:","\t\t\t\twrite_HSV(self.hsv_text, self.hsv_range)","\t\t\t\tself.Hmin  = rclpy.parameter.Parameter('Hmin',rclpy.Parameter.Type.INTEGER,self.hsv_range[0][0])","\t\t\t\tself.Smin  = rclpy.parameter.Parameter('Smin',rclpy.Parameter.Type.INTEGER,self.hsv_range[0][1])","\t\t\t\tself.Vmin  = rclpy.parameter.Parameter('Vmin',rclpy.Parameter.Type.INTEGER,self.hsv_range[0][2])","\t\t\t\tself.Hmax  = rclpy.parameter.Parameter('Hmax',rclpy.Parameter.Type.INTEGER,self.hsv_range[1][0])","\t\t\t\tself.Smax  = rclpy.parameter.Parameter('Smax',rclpy.Parameter.Type.INTEGER,self.hsv_range[1][1])","\t\t\t\tself.Vmax  = rclpy.parameter.Parameter('Vmax',rclpy.Parameter.Type.INTEGER,self.hsv_range[1][2])","","\t\t\t\t","\t\t\t\tall_new_parameters = [self.Hmin,self.Smin,self.Vmin,self.Hmax,self.Smax,self.Vmax]","\t\t\t\tself.set_parameters(all_new_parameters)","\t\t\t\tself.dyn_update = False","\t\tif self.Track_state == 'tracking' :","\t\t\tif len(self.circle) != 0:","\t\t\t\tthreading.Thread(target=self.execute, args=(self.circle[0], self.circle[2])).start()","\t\telse:","\t\t\tif self.Start_state == True:","\t\t\t\t#self.pub_cmdVel.publish(Twist())","\t\t\t\tself.Start_state = False","\t\tif len(self.tags)>0 and self.Track_state!=\"Remove\":","\t\t\tself.Track_state = \"identify\"","\t\t\tself.pub_cmdVel.publish(Twist())","\t\t\tprint(\"Find the apriltag.\")","\t\t\tself.Track_state = \"Remove\"","\t\tif  self.Track_state == \"Remove\":","\t\t\tprint(\"len(tags) = \",len(self.tags))","\t\t\tif len(self.tags)>0 :","\t\t\t\tcenter_x, center_y = self.tags[0].center","\t\t\t\tif (abs(center_x-320) >10 or abs(center_y-400)>10) and self.move_flag == True: ","\t\t\t\t\tprint(\"adjusting.\")","\t\t\t\t\tself.remove_obstacle(center_x, center_y)","\t\t\t\tif abs(center_x-320) <10 and abs(center_y-400)<10:","\t\t\t\t\tself.pubVel(0.0, 0.0)","\t\t\t\t\tprint(\"start crawling.\")","\t\t\t\t\ttime.sleep(3)","\t\t\t\t\tc_dist = self.depth_image_info[int(center_y),int(center_x)]/1000","\t\t\t\t\tif c_dist!=0 and self.pubPos_flag == True:","\t\t\t\t\t\tself.move_flag = False","\t\t\t\t\t\tself.pubPos_flag = False","\t\t\t\t\t\tpos = AprilTagInfo()","\t\t\t\t\t\tpos.id = self.tags[0].tag_id","\t\t\t\t\t\tpos.x = center_x","\t\t\t\t\t\tpos.y = center_y","\t\t\t\t\t\tpos.z = c_dist","\t\t\t\t\t\tvx = int(self.tags[0].corners[0][0]) - int(self.tags[0].corners[1][0])","\t\t\t\t\t\tvy = int(self.tags[0].corners[0][1]) - int(self.tags[0].corners[1][1])","\t\t\t\t\t\ttarget_joint5 = compute_joint5(vx,vy)","\t\t\t\t\t\tprint(\"target_joint5: \",target_joint5)","\t\t\t\t\t\tself.joint5.data = int(target_joint5)","\t\t\t\t\t\tprint(\"tag_id: \",self.tags[0].tag_id)","\t\t\t\t\t\tprint(\"center_x, center_y: \",center_x, center_y)","\t\t\t\t\t\tprint(\"depth: \",c_dist)","\t\t\t\t\t\tself.pos_info_pub.publish(pos)","\t\t\t\t\t\tself.TargetJoint5_pub.publish(self.joint5)","\t\t\t\t\t\tself.TargetJoint5_pub.publish(self.joint5)","\t\t\t\t\telse:","\t\t\t\t\t\tprint(\"Invalid distance.\")","                ","\t\treturn rgb_img, binary","","\tdef pubVel(self,vx,vy):","\t\tvel = Twist()","\t\tvel.linear.x = vx","\t\tvel.linear.y = vy","","\t\tself.pub_cmdVel.publish(vel)","        ","\tdef remove_obstacle(self,point_x, point_y):","\t\t[y, x] = self.Remove_PID_controller.update([(point_x - 320) / 10.0, (point_y - 400) / 10.0])","\t\tif x >= 0.10: x = 0.10 #0.10","\t\telif x <= -0.10: x = -0.10","\t\tif y >= 0.10: y = 0.10","\t\telif y <= -0.10: y = -0.10","\t\tself.pubVel(x, y)        ","\t\t","\tdef JoyStateCallback(self,msg):","\t\tif not isinstance(msg, Bool): return","\t\tself.Joy_active = msg.data","\t\t#self.pub_cmdVel.publish(Twist())","","","\tdef Reset(self):","\t\tself.PID_init()","\t\tself.Track_state = 'init'","\t\tself.hsv_range = ()","\t\tself.Joy_active =False","\t\tself.Mouse_XY = (0, 0)","\t\tself.pub_cmdVel.publish(Twist())","\t\tprint(\"Reset succes!!!\")","","\tdef get_param(self):","\t\t#hsv","\t\tself.Hmin = self.get_parameter('Hmin').get_parameter_value().integer_value","\t\tself.Smin = self.get_parameter('Smin').get_parameter_value().integer_value","\t\tself.Vmin = self.get_parameter('Vmin').get_parameter_value().integer_value","\t\tself.Hmax = self.get_parameter('Hmax').get_parameter_value().integer_value","\t\tself.Smax = self.get_parameter('Smax').get_parameter_value().integer_value","\t\tself.Vmax = self.get_parameter('Vmax').get_parameter_value().integer_value","\t\t#kpi","\t\tself.Kd = self.get_parameter('Kd').get_parameter_value().integer_value","\t\tself.Ki = self.get_parameter('Ki').get_parameter_value().integer_value","\t\tself.Kp = self.get_parameter('Kp').get_parameter_value().integer_value","\t\tself.FollowLinePID = (self.Kp,self.Ki,self.Kd)","\t\t#","\t\tself.scale = self.get_parameter('scale').get_parameter_value().integer_value","\t\tself.LaserAngle = self.get_parameter('LaserAngle').get_parameter_value().integer_value","\t\tself.linear = self.get_parameter('linear').get_parameter_value().double_value","\t\tself.ResponseDist = self.get_parameter('ResponseDist').get_parameter_value().double_value","\t\tself.refresh = self.get_parameter('refresh').get_parameter_value().bool_value","","\t\t","def main():","\t# ================================================================","\t#  BEGINNER STARTUP SCREEN","\t#  Only display messages are added here; robot logic is unchanged.","\t# ================================================================","\tprint()","\tprint(\"=\" * 64)","\tprint(\"        M3Pro ROBOT - LINE FOLLOW + APRILTAG\")","\tprint(\"=\" * 64)","\tprint(\"  Starting ROS 2 node...\")","\tprint()","\tprint(\"  What this program does:\")","\tprint(\"    [1] Detects and follows a line\")","\tprint(\"    [2] Detects AprilTags\")","\tprint(\"    [3] Uses the laser scanner for obstacle safety\")","\tprint(\"    [4] Controls the robot arm when an AprilTag is found\")","\tprint()","\tprint(\"  Keyboard controls:\")","\tprint(\"    SPACE  -> Start / tracking mode\")","\tprint(\"    I      -> Identify/load HSV settings\")","\tprint(\"    R      -> Reset\")","\tprint(\"    Q      -> Quit\")","\tprint()","\tprint(\"  Important:\")","\tprint(\"    Keep the robot area clear before starting.\")","\tprint(\"    The robot will stop when an obstacle is detected.\")","\tprint(\"-\" * 64)","","\trclpy.init()","\tlinedetect = LineDetect(\"follow_line\")","\tprint(\"  [OK] ROS 2 node started: follow_line\")","\tprint(\"  [OK] Camera / depth processing initialized\")","\tprint(\"  [OK] Line-following system ready\")","\tprint(\"  [OK] AprilTag detection ready\")","\tprint()","\tprint(\"  >>> System is RUNNING. <<<\")","\tprint(\"=\" * 64)","\tprint()","\ttry:","\t\trclpy.spin(linedetect)","\texcept KeyboardInterrupt:","\t\tpass","\tfinally:","\t\tprint()","\t\tprint(\"=\" * 64)","\t\tprint(\"  Stopping robot safely...\")","\t\tprint(\"  [OK] Zero velocity command sent\")","\t\tprint(\"  [OK] ROS 2 node stopped\")","\t\tprint(\"  Goodbye!\")","\t\tprint(\"=\" * 64)","\t\tlinedetect.pub_cmdVel.publish(Twist())","\t\tlinedetect.destroy_node()","\t\trclpy.shutdown()"],"save_map.launch.py":["# --- IMPORTING ROS 2 LAUNCH TOOLS ---","from launch import LaunchDescription","from launch.actions import DeclareLaunchArgument","from launch.substitutions import LaunchConfiguration","from ament_index_python.packages import get_package_share_directory","from launch_ros.actions import Node","import os","from ament_index_python.packages import get_package_share_path","","def generate_launch_description():","    ","    # --- 1. NAMING THE MAP ---","    # Give the map a name so you know what it is later!","    map_name = \"yahboom_map\"","    ","    # Figure out where to save it. ","    # It goes into the 'M3Pro_navigation' package, inside a folder called 'map'.","    default_map_path = os.path.join(get_package_share_path(\"M3Pro_navigation\"), 'map', map_name)","","    # --- 2. CREATING A LAUNCH ARGUMENT ---","    # This lets you type a different name in the terminal if you want to (e.g. map_path:=my_new_map)","    # But if you don't type anything, it uses the default 'yahboom_map' path from above.","    map_arg = DeclareLaunchArgument(","        name='map_path', ","        default_value=str(default_map_path),","        description='The path of the map'","    )","","    # --- 3. THE MAP SAVER NODE ---","    # Start the official ROS 2 Navigation (Nav2) map saving tool.","    map_saver_node = Node(","        package='nav2_map_server',          # Look in the Nav2 map server package","        executable='map_saver_cli',         # Run the command line interface (CLI) tool","        ","        # Give the tool some specific instructions (arguments):","        arguments=[","            '-f', LaunchConfiguration('map_path'),  # '-f' means \"Save the file at this path\"","            ","            '--free', '0.196',  # Threshold for \"Free Space\": If the robot is less than 19.6% sure a spot is a wall, make it White (clear).","            '--occ', '0.65'     # Threshold for \"Occupied Space\": If the robot is more than 65% sure a spot is a wall, make it Black (solid).","        ],","    )","","    # --- THE FINAL LIST ---","    # Hand the list back to ROS 2 to start the tool and save the map!","    return LaunchDescription([","        map_arg,","        map_saver_node","    ])"]}
